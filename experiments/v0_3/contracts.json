{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "answer",
        "missing_info",
        "evidence",
        "p_answerable",
        "p_correct_if_committed"
      ],
      "properties": {
        "status": {
          "enum": [
            "KNOWN",
            "INFERRED",
            "UNCERTAIN",
            "UNKNOWN"
          ]
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "missing_info": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 512
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "doc_id",
              "start",
              "end"
            ],
            "additionalProperties": false,
            "properties": {
              "doc_id": {
                "type": "string"
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "p_answerable": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "p_correct_if_committed": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "UNKNOWN",
                  "UNCERTAIN"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "answer": {
                "type": "null"
              },
              "missing_info": {
                "minItems": 1
              },
              "p_correct_if_committed": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "answer": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdicts"
      ],
      "properties": {
        "verdicts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "proposal_id",
              "support",
              "evidence"
            ],
            "properties": {
              "proposal_id": {
                "type": "string"
              },
              "support": {
                "enum": [
                  "ENTAILS",
                  "CONTRADICTS",
                  "INSUFFICIENT"
                ]
              },
              "evidence": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "required": [
                    "doc_id",
                    "start",
                    "end"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "doc_id": {
                      "type": "string"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
