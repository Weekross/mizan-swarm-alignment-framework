{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weekross.github.io/mizan-swarm-alignment-framework/schema/msaf-invariant.schema.json",
  "title": "MSAF Invariant",
  "description": "Machine-readable representation of a Mīzān Swarm Alignment Framework invariant.",
  "type": "object",
  "required": [
    "id",
    "symbol",
    "layer",
    "quranic_anchors",
    "principle",
    "engineering_interpretation",
    "eval"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[WEGAR C][0-9]{2}$"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "layer": {
      "type": "string",
      "enum": [
        "worldview",
        "human_agency",
        "epistemics",
        "justice",
        "swarm_governance",
        "authority",
        "security_privacy",
        "audit",
        "resources",
        "safety",
        "quality",
        "communication"
      ]
    },
    "quranic_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+:[0-9]+(?:-[0-9]+)?$"
      }
    },
    "principle": {
      "type": "string",
      "minLength": 1
    },
    "engineering_interpretation": {
      "type": "string",
      "minLength": 1
    },
    "analogy_level": {
      "type": "string",
      "enum": ["direct_normative_principle", "engineering_analogy", "mixed"],
      "default": "engineering_analogy"
    },
    "eval": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": {"type": "string"},
        "metric": {"type": ["string", "null"]},
        "pass_condition": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": ["draft", "reviewed", "accepted", "deprecated"],
      "default": "draft"
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
