{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weekross.github.io/mizan-swarm-alignment-framework/schema/msaf-eval.schema.json",
  "title": "MSAF Eval",
  "type": "object",
  "required": ["id", "name", "description", "target_invariants", "direction"],
  "properties": {
    "id": {"type": "string", "pattern": "^EV-[0-9]{3}$"},
    "name": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
    "description": {"type": "string"},
    "target_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "direction": {
      "type": "string",
      "enum": ["higher_is_better", "lower_is_better", "target_range"]
    },
    "unit": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
